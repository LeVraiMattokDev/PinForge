    },
    {
      "id": "sfx-coin",
      "kind": "sound",
      "source": "assets/coin.wav",
      "volume": 1,
      "loop": false
    }
  ],
  "tilesets": [
    {
      "id": "grass",
      "name": "Grass",
      "image": "tiles-grass",
      "tileWidth": 16,
      "tileHeight": 16,
      "margin": 0,
      "spacing": 0,
      "tiles": [
        {
          "index": 0,
          "name": "Ground",
          "tags": ["solid"]
        },
        {
          "index": 3,
          "name": "Wooden platform",
          "tags": ["one-way"]
        },
        {
          "index": 8,
          "name": "Spikes",
          "tags": ["hazard"]
        },
        {
          "index": 12,
          "name": "Cloud",
          "tags": []
        }
      ]
    }
  ],
  "entities": [
    {
      "id": "player",
      "name": "Player",
      "size": {
        "width": 12,
        "height": 16
      },
      "tags": ["player"],
      "properties": [
        {
          "id": "invulnerable-for",
          "name": "Invulnerable for",
          "type": "number",
          "initial": 0,
          "countsDown": true
        }
      ],
      "components": {
        "sprite": {
          "image": "player-sheet",
          "frameWidth": 16,
          "frameHeight": 16,
          "offset": {
            "x": -2,
            "y": 0
          },
          "flipToFaceMovement": true,
          "defaultAnimation": "idle",
          "animations": [
            {
              "id": "idle",
              "name": "Idle",
              "frames": [0, 1],
              "fps": 4,
              "loop": true
            },
            {
              "id": "run",
              "name": "Run",
              "frames": [2, 3, 4, 5],
              "fps": 12,
              "loop": true
            },
            {
              "id": "jump",
              "name": "Jump",
              "frames": [6],
              "fps": 1,
              "loop": false
            }
          ]
        },
        "collider": {
          "kind": "solid",
          "collidesWithTiles": true
        },
        "movement": {
          "mode": "platform",
          "controlledBy": "player",
          "maxSpeed": 90,
          "acceleration": 600,
          "deceleration": 900,
          "airControl": 0.7,
          "gravity": 900,
          "fallGravityMultiplier": 1.7,
          "maxFallSpeed": 320,
          "jumpHeight": 44,
          "jumpCount": 1,
          "variableJumpHeight": true,
          "coyoteTime": 0.1,
          "jumpBufferTime": 0.12
        }
      }
    },
    {
      "id": "coin",
      "name": "Coin",
      "size": {
        "width": 8,
        "height": 8
      },
      "tags": ["pickup"],
      "properties": [],
      "components": {
        "sprite": {
          "image": "coin-sheet",
          "frameWidth": 8,
          "frameHeight": 8,
          "offset": {
            "x": 0,
            "y": 0
          },
          "flipToFaceMovement": false,
          "defaultAnimation": "spin",
          "animations": [
            {
              "id": "spin",
              "name": "Spin",
              "frames": [0, 1, 2, 3],
              "fps": 8,
              "loop": true
            }
          ]
        },
        "collider": {
          "kind": "trigger",
          "collidesWithTiles": false
        }
      }
    },
    {
      "id": "slime",
      "name": "Slime",
      "size": {
        "width": 14,
        "height": 12
      },
      "tags": ["enemy"],
      "properties": [],
      "components": {
        "sprite": {
          "image": "slime-sheet",
          "frameWidth": 16,
          "frameHeight": 16,
          "offset": {
            "x": -1,
            "y": -4
          },
          "flipToFaceMovement": true,
          "defaultAnimation": "walk",
          "animations": [
            {
              "id": "walk",
              "name": "Walk",
              "frames": [0, 1],
              "fps": 6,
              "loop": true
            }
          ]
        },
        "collider": {
          "kind": "solid",
          "collidesWithTiles": true
        },
        "movement": {
          "mode": "platform",
          "controlledBy": "rules",
          "maxSpeed": 24,
          "acceleration": 400,
          "deceleration": 400,
          "airControl": 1,
          "gravity": 900,
          "fallGravityMultiplier": 1.7,
          "maxFallSpeed": 320,
          "jumpHeight": 0,
          "jumpCount": 0,
          "variableJumpHeight": false,
          "coyoteTime": 0,
          "jumpBufferTime": 0,
          "patrol": {
            "direction": "left",
            "turnAtWalls": true,
            "turnAtLedges": true
          }
        }
      }
    },
    {
      "id": "flag",
      "name": "Flag",
      "size": {
        "width": 12,
        "height": 24
      },
      "tags": ["goal"],
      "properties": [],
      "components": {
        "sprite": {
          "image": "flag-sheet",
          "frameWidth": 16,
          "frameHeight": 24,
          "offset": {
            "x": -2,
            "y": 0
          },
          "flipToFaceMovement": false,
          "defaultAnimation": "wave",
          "animations": [
            {
              "id": "wave",
              "name": "Wave",
              "frames": [0, 1],
              "fps": 4,
              "loop": true
            }
          ]
        },
        "collider": {
          "kind": "trigger",
          "collidesWithTiles": false
        }
      }
    },
    {
      "id": "score-label",
      "name": "Score label",
      "size": {
        "width": 80,
        "height": 10
      },
      "tags": ["hud"],
      "properties": [],
      "components": {
        "text": {
          "content": "Score: {score}",
          "color": "#ffffff",
          "align": "left",
          "size": "normal"
        }
      }
    }
  ],
  "globalEvents": [
    {
      "id": "restart-when-out-of-lives",
      "name": "Game over when out of lives",
      "enabled": true,
      "once": false,
      "when": {
        "type": "variable-changes",
        "variable": "lives"
      },
      "if": [
        {
          "type": "variable-is",
          "variable": "lives",
          "operator": "at-most",
          "value": 0,
          "negate": false
        }
      ],
      "then": [
        {
          "type": "show-message",
          "text": "Game over",
          "seconds": 2
        },
        {
          "type": "set-variable",
          "variable": "lives",
          "value": 3
        },
        {
          "type": "set-variable",
          "variable": "score",
          "value": 0
        },
        {
          "type": "go-to-scene",
          "scene": "level-1"
        }
      ]
    }
  ],
