{
  "formatVersion": 1,
  "meta": {
    "name": "Coin Run",
    "author": "PinStudio",
    "description": "A tiny platformer used to validate the project format.",
    "created": "2026-08-20T10:00:00Z",
    "modified": "2026-08-20T10:00:00Z"
  },
  "settings": {
