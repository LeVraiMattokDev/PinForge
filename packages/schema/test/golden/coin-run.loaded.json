      "width": 320,
      "height": 180,
      "scaleMode": "integer"
    },
    "pixelArt": true,
    "backgroundColor": "#10141c",
    "input": {
      "left": ["ArrowLeft", "KeyA"],
      "right": ["ArrowRight", "KeyD"],
      "up": ["ArrowUp", "KeyW"],
      "down": ["ArrowDown", "KeyS"],
      "jump": ["Space", "ArrowUp", "KeyW"],
      "action": ["KeyE", "Enter"],
      "pause": ["Escape"]
    }
  },
  "variables": [
    {
      "id": "score",
      "name": "Score",
      "type": "number",
      "initial": 0,
      "countsDown": false
    },
    {
      "id": "lives",
      "name": "Lives",
      "type": "number",
      "initial": 3,
      "countsDown": false
    }
  ],
