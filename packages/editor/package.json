{
  "name": "@pinforge/editor",
  "version": "0.0.0",
  "private": true,
  "description": "The PinForge visual editor.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-starter.mjs && vite",
    "build": "node scripts/build-starter.mjs && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "node scripts/build-starter.mjs && tsc -p tsconfig.json --noEmit",
    "test": "node scripts/build-starter.mjs && vitest run"
  },
  "dependencies": {
    "@pinforge/core": "workspace:*",
    "@pinforge/schema": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "vite": "^6.3.0"
  }
}
